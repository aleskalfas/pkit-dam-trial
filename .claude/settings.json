{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.pkit/adapters/claude-code/session-start-hook.py"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}\"/.pkit/adapters/claude-code/session-start-hook.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.pkit/adapters/claude-code/permission-hook.py"
          }
        ]
      }
    ]
  },
  "agent": "project-manager",
  "permissions": {
    "allow": [
      "Bash(.pkit/**/*.sh)",
      "Bash(cat:*)",
      "Bash(chmod +x:*)",
      "Bash(cp:*)",
      "Bash(echo:*)",
      "Bash(find:*)",
      "Bash(gh:*)",
      "Bash(git:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(jq:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(pkit:*)",
      "Bash(pwd)",
      "Bash(ssh-keygen:*)",
      "Bash(ssh:*)",
      "Bash(tail:*)",
      "Edit",
      "Glob",
      "Grep",
      "MultiEdit",
      "Read",
      "Skill(adapter-author)",
      "Skill(agent-author)",
      "Skill(area-author)",
      "Skill(capability-author)",
      "Skill(decision-author)",
      "Skill(migration-author)",
      "Skill(pm)",
      "Skill(process)",
      "Skill(report-author)",
      "Skill(schema)",
      "Skill(scratchpad-author)",
      "Skill(storyboard-author)",
      "Skill(update-config)",
      "Write"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(rm --recursive:*)",
      "Bash(rm -R:*)",
      "Bash(rm -Rf:*)",
      "Bash(rm -fR:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -r:*)",
      "Bash(rm -rf $HOME:*)",
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)"
    ]
  }
}
